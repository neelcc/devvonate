// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum FileStatus {
  ACTIVE
  IN_PROGRESS
  ARCHIVED
  DELETING
  DELETED
}

enum UploadStatus {
  PENDING
  UPLOADING
  COMPLETING
  COMPLETED
  FAILED
  ABORTED
  EXPIRED
}

enum FileCategory {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  ARCHIVE
}

model User {
  id            String         @id @default(uuid())
  firstName     String
  lastName      String
  email         String         @unique
  password      String
  role          Role           @default(USER)
  rootFolderId  String?         @unique
  files         File[]
  folders       Folder[]
  refreshTokens RefreshToken[]
  storage       UserStorage?
  fileUploads   FileUpload[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("refreshTokens")
}

model Folder {
  id             String    @id @default(uuid())
  userId         String
  parentFolderId String?
  name           String
  path           String // e.g. "  <rootId>/<child1Id>/<child2Id>/"
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  parent   Folder?  @relation("FolderToFolder", fields: [parentFolderId], references: [id])
  children Folder[] @relation("FolderToFolder")
  Files    File[]

  @@unique([parentFolderId, name, userId], name: "uniq_name_in_parent")
  @@index([userId, deletedAt])
  @@index([path])
  @@map("folders")
}

model UserStorage {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  totalBytes    BigInt   @default(0) // in bytes
  usedBytes     BigInt   @default(0) // in bytes
  trashBytes    BigInt   @default(0) // in bytes
  reservedBytes BigInt   @default(0) // in bytes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("userStorage")
}

model File {
  id          String @id @default(uuid())
  folderId    String
  userId      String
  name        String
  path        String // e.g. "  <rootId>/<child1Id>/<child2Id>/"
  size        BigInt // in bytes
  contentType String
  category    FileCategory 
  deletedAt   DateTime?
  s3KeyName   String     @unique
  status      FileStatus @default(ACTIVE)
  user        User       @relation(fields: [userId], references: [id])
  folder      Folder     @relation(fields: [folderId], references: [id])

  FileUpload FileUpload[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, deletedAt])
  @@index([path])
  @@map("files")
}

model FileUpload {
  id              String           @id @default(uuid())
  fileId          String
  s3UploadId      String           @unique       
  file            File             @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  totalParts      Int              @default(0)
  partsSize       BigInt           @default(0) // in bytes
  status          UploadStatus     @default(PENDING)
  s3ETag          String?          @unique
  expiresAt       DateTime? 
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("fileUploads")
}

